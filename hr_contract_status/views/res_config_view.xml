<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">hr settings for contract state</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='hr']//block[@id='contract_work_permit_expiration_notify']"
                position="inside"
            >
                <setting
                    id="concurrent_contracts_setting"
                    help="Employees can have more than one contract active at a time"
                    title="Allow multiple concurrent employee contracts."
                >
                    <field name="concurrent_contracts" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
