<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.inherit.hr_data_import</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='hr_settings']" position="inside">
                    <group name="hr_data_import" string="Imported Data">
                        <group>
                            <field name="hire_date" />
                        </group>
                        <group>
                            <field name="import_data_id" />
                        </group>
                        <group string="Annual Leave">
                            <field name="anlv_earned" />
                            <field name="anlv_used" />
                            <field name="anlv_remain" />
                            <field name="anlv_date" />
                        </group>
                    </group>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
