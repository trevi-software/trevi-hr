<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_config_contract_state" model="ir.ui.view">
        <field name="name">hr settings for contract state</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='employee_rights_setting_container']"
                position="after"
            >
                <h2>Default HR Responsible</h2>
                <div
                    class="row mt16 o_settings_container"
                    name="employee_contracts_setting_container"
                >
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        title="Set the default HR responsible for employees"
                    >
                        <div class="o_setting_left_pane">
                            <field name="hr_responsible" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="hr_responsible" />
                            <div class="text-muted">
                                This setting allows you to set a default HR responsible for employees.
                                When enabled, the default HR responsible will be
                                automatically assigned to new employees created in the system.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
