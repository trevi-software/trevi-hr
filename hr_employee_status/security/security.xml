<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Only show terminations in the user's current company -->

    <record id="hr_contract_comp_rule" model="ir.rule">
        <field name="name">Employee separation: multi-company</field>
        <field name="model_id" ref="hr_employee_status.model_hr_employee_termination" />
        <field eval="True" name="global" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Ordinary users may only read their own separation records and those of
         the employees in the departments they manage. This rule was lost in a
         contract-workflow fix; the read grant for base.group_user exists only
         so the employee form can render its "Deactivation" page, not to expose
         every coworker's separation date and notes. -->
    <record id="hr_employee_separation_rule_own" model="ir.rule">
        <field name="name">Employee Separation: Own and Subordinates</field>
        <field name="model_id" ref="model_hr_employee_termination" />
        <field name="domain_force">
            ['|',('employee_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- HR officers keep full access: group rules are OR'ed together. -->
    <record id="hr_employee_separation_rule_hr_user" model="ir.rule">
        <field name="name">Employee Separation: HR Users</field>
        <field name="model_id" ref="model_hr_employee_termination" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
    </record>
</odoo>
