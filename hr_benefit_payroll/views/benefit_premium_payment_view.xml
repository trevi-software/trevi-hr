<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Premium Payments -->

    <record id="view_premium_payments_filter" model="ir.ui.view">
        <field name="name">hr.benefit.premium.payment.filter</field>
        <field name="model">hr.benefit.premium.payment</field>
        <field name="arch" type="xml">
            <search string="Search All Payments">
                <field name="date" />
                <field name="policy_id" />
                <separator />
                <filter
                    string="My Payments"
                    icon="terp-personal"
                    name="my_payments"
                    domain="[('employee_id.user_id','=', uid)]"
                />
                <separator />
                <field name="employee_id" />
                <field name="state" />
                <group expand="0" string="Group By...">
                    <filter
                        name="group_date"
                        string="Date"
                        icon="terp-personal"
                        domain="[]"
                        context="{'group_by':'date'}"
                    />
                    <filter
                        name="group_policy"
                        string="Policy"
                        icon="terp-stock_symbol-selection"
                        domain="[]"
                        context="{'group_by':'policy_id'}"
                    />
                    <filter
                        name="group_employee"
                        string="Employee"
                        icon="terp-personal"
                        domain="[]"
                        context="{'group_by':'employee_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_premium_payments_list" model="ir.ui.view">
        <field name="name">hr.benefit.premium.payment.list</field>
        <field name="model">hr.benefit.premium.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="policy_id" />
                <field name="employee_id" />
                <field name="date" />
                <field name="amount" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_premium_payments_form" model="ir.ui.view">
        <field name="name">hr.benefit.premium.payment.from</field>
        <field name="model">hr.benefit.premium.payment</field>
        <field name="arch" type="xml">
            <form string="Premium Payment">
                <header>
                    <button
                        name="action_pending"
                        type="object"
                        invisible="state != 'draft'"
                        string="Pending"
                        class="oe_highlight"
                    />
                    <button
                        name="action_done"
                        type="object"
                        invisible="state != 'pending'"
                        string="Confirm"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        invisible="state not in ['draft', 'pending']"
                        string="Cancel"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <group>
                    <group>
                        <field name="employee_id" readonly="state != 'draft'" />
                        <field name="policy_id" readonly="state != 'draft'" />
                        <field name="date" readonly="state != 'draft'" />
                        <field name="amount" readonly="state != 'draft'" />
                    </group>
                    <group>
                        <field name="payslip_id" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="open_premium_payments_view" model="ir.actions.act_window">
        <field name="name">Premium Payments</field>
        <field name="res_model">hr.benefit.premium.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_premium_payments_filter" />
    </record>
    <menuitem
        id="menu_premium_payments"
        action="open_premium_payments_view"
        parent="hr_benefit.menu_claims_root"
        groups="base.group_user"
        sequence="10"
    />
</odoo>
