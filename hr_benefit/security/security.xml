<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="hr_benefit_policy_rule_own" model="ir.rule">
            <field name="name">Benefit Policy: Own and Subordinates</field>
            <field name="model_id" ref="model_hr_benefit_policy" />
            <field name="domain_force">
                ['|',('employee_id.user_id', '=', user.id),
                ('employee_id.department_id.manager_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="hr_benefit_policy_rule_officer" model="ir.rule">
            <field name="name">Benefit Policy: HR Officer can see all</field>
            <field name="model_id" ref="model_hr_benefit_policy" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        </record>
    </data>

    <data noupdate="1">
        <!-- hr.benefit: Multi-company -->
        <record id="hr_benefit_restricted_company_rule" model="ir.rule">
            <field name="name">Benefit: multi-company</field>
            <field name="model_id" ref="hr_benefit.model_hr_benefit" />
            <field name="global" eval="True" />
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

        <!-- Only show policies for employees in the user's current company -->
        <record id="hr_benefit_policy_restricted_company_rule" model="ir.rule">
            <field name="name">Benefit Policy: multi-company</field>
            <field name="model_id" ref="hr_benefit.model_hr_benefit_policy" />
            <field name="global" eval="True" />
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

        <!-- Claims, premiums and earnings inherit their company from the parent
             record, so they need their own rule to keep the amounts that belong
             to another company out of reach of direct reads. -->
        <record id="hr_benefit_claim_restricted_company_rule" model="ir.rule">
            <field name="name">Benefit Claim: multi-company</field>
            <field name="model_id" ref="hr_benefit.model_hr_benefit_claim" />
            <field name="global" eval="True" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="hr_benefit_premium_restricted_company_rule" model="ir.rule">
            <field name="name">Benefit Premium: multi-company</field>
            <field name="model_id" ref="hr_benefit.model_hr_benefit_premium" />
            <field name="global" eval="True" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="hr_benefit_advantage_restricted_company_rule" model="ir.rule">
            <field name="name">Benefit Advantage: multi-company</field>
            <field name="model_id" ref="hr_benefit.model_hr_benefit_advantage" />
            <field name="global" eval="True" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
