<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- hr.contract was merged into hr and renamed hr.version in Odoo 19 -->
    <record id="hr_version_view_form" model="ir.ui.view">
        <field name="name">hr.version.form.inherit.resource.schedule</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="before">
                <field name="default_area_id" />
            </xpath>
        </field>
    </record>
</odoo>